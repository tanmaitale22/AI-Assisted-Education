<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/daa_ontology.owl"
         xmlns="http://example.org/daa_ontology.owl#">

<owl:Ontology rdf:about="http://example.org/daa_ontology.owl"/>

<owl:ObjectProperty rdf:about="#hasTopic">
  <rdfs:domain rdf:resource="#Subject"/>
  <rdfs:range rdf:resource="#Topic"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSubtopic">
  <rdfs:domain rdf:resource="#Topic"/>
  <rdfs:range rdf:resource="#Concept"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#belongsTo">
  <rdfs:domain rdf:resource="#Concept"/>
  <rdfs:range rdf:resource="#Topic"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#uses">
  <rdfs:domain rdf:resource="#Algorithm"/>
  <rdfs:range rdf:resource="#DataStructure"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#solves">
  <rdfs:domain rdf:resource="#Algorithm"/>
  <rdfs:range rdf:resource="#Problem"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requires">
  <rdfs:domain rdf:resource="#Concept"/>
  <rdfs:range rdf:resource="#Concept"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#relatedTo">
  <rdfs:domain rdf:resource="#Concept"/>
  <rdfs:range rdf:resource="#Concept"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Subject">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Topic">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Concept">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Algorithm">
  <rdfs:subClassOf rdf:resource="#Concept"/>
</owl:Class>

<owl:Class rdf:about="#DataStructure">
  <rdfs:subClassOf rdf:resource="#Concept"/>
</owl:Class>

<owl:Class rdf:about="#Problem">
  <rdfs:subClassOf rdf:resource="#Concept"/>
</owl:Class>

<owl:Class rdf:about="#Technique">
  <rdfs:subClassOf rdf:resource="#Concept"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#Graph_Traversal">
  <rdf:type rdf:resource="#Concept"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Breadth_First_Search">
  <rdf:type rdf:resource="#Algorithm"/>
  <relatedTo rdf:resource="#Graph_Traversal"/>
  <uses rdf:resource="#Queue"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Queue">
  <rdf:type rdf:resource="#DataStructure"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Depth_First_Search">
  <rdf:type rdf:resource="#Algorithm"/>
  <relatedTo rdf:resource="#Graph_Traversal"/>
  <uses rdf:resource="#Stack"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Stack">
  <rdf:type rdf:resource="#DataStructure"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Dijkstras_Algorithm">
  <rdf:type rdf:resource="#Algorithm"/>
  <solves rdf:resource="#Shortest_Path_Problem"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Shortest_Path_Problem">
  <rdf:type rdf:resource="#Problem"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Dynamic_Programming">
  <rdf:type rdf:resource="#Technique"/>
  <requires rdf:resource="#Optimal_Substructure"/>
  <requires rdf:resource="#Overlapping_Subproblems"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Optimal_Substructure">
  <rdf:type rdf:resource="#Concept"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Overlapping_Subproblems">
  <rdf:type rdf:resource="#Concept"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Merge_Sort">
  <rdf:type rdf:resource="#Algorithm"/>
  <uses rdf:resource="#Divide_and_Conquer"/>
  <relatedTo rdf:resource="#Sorting"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Divide_and_Conquer">
  <rdf:type rdf:resource="#Technique"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sorting">
  <rdf:type rdf:resource="#Concept"/>
</owl:NamedIndividual>


</rdf:RDF>
